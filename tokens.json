{
  "$schema": "design-tokens/v1",
  "name": "nullxx-design-system",
  "description": "nullxx design system — light mode v1",
  "colour": {
    "surface": {
      "base": "#e6e9ee",
      "card": "#e6e9ee"
    },
    "shadow": {
      "dark": "#ccd0d6",
      "light": "#ffffff"
    },
    "text": {
      "primary": "#3a3f4a",
      "secondary": "#767c88"
    },
    "accent": {
      "teal": "#2f8a8a",
      "tealLight": "#6fc4c4"
    },
    "border": {
      "hairline": "#d3d7dd"
    }
  },
  "radius": {
    "card": "22px",
    "control": "13px",
    "badge": "20px",
    "progress": "6px"
  },
  "spacing": {
    "xs": "4px",
    "sm": "8px",
    "md": "12px",
    "lg": "16px",
    "xl": "20px",
    "2xl": "24px",
    "3xl": "32px"
  },
  "shadow": {
    "cardRaised": "2px 2px 5px #ccd0d6, -2px -2px 5px #ffffff",
    "cardInset": "inset 1px 1px 2px #ccd0d6, inset -1px -1px 2px #ffffff",
    "controlRaised": "2px 2px 4px #ccd0d6, -2px -2px 4px #ffffff"
  },
  "typography": {
    "fontFamily": "'Google Sans Flex', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
    "scale": {
      "heading": { "size": "1rem", "weight": 700 },
      "body": { "size": "0.78rem", "weight": 400 },
      "label": { "size": "0.66rem", "weight": 600 }
    }
  },
  "openDecisions": [
    "Dark mode palette not yet defined",
    "Typeface is still system default, no display or body face chosen",
    "Only teal accent locked, no secondary or semantic colours (success, warning, error) defined yet"
  ]
}
